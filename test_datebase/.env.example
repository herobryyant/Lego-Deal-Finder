# Create an eBay developer application at https://developer.ebay.com/
# Choose ONE environment and copy both values from that same keyset.
# App ID = Client ID. Cert ID = Client Secret. Do not use the Dev ID or a token.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=your-app-id
EBAY_CLIENT_SECRET=your-cert-id
EBAY_MARKETPLACE_ID=EBAY_US

# Set these after deployment. The endpoint must exactly match the public HTTPS
# URL entered in the eBay developer portal, including its path and trailing slash.
EBAY_DELETION_ENDPOINT=https://your-app.onrender.com/api/ebay/account-deletion
EBAY_DELETION_VERIFICATION_TOKEN=generate-a-private-32-to-80-character-token

# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Use true on an HTTPS production deployment. Keep false on localhost.
COOKIE_SECURE=false
PORT=3000
